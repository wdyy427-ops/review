/outputs/rq_review_20261024/_deps/
/outputs/rq_review_20261024/node_modules/

# ============================================================
# Temporary files, logs, process state, and inspection dumps
# ============================================================
/tmp/
*.log
*.pid
*.err.txt
*.out.txt
*.inspect.ndjson

# ============================================================
# Rebuildable QA renders, previews, and integration workspaces
